<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Flag indicating whether the device has a physical home key -->
    <bool name="config_hasHardwareHomeKey">false</bool>

    <!-- Whether the device has a backlight on the hardware buttons -->
    <bool name="config_deviceHasVariableButtonBrightness">false</bool>

    <!-- Minimum and maximum screen brightness setting -->
    <integer name="config_screenBrightnessSettingMinimum">2</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>
    <integer name="config_screenBrightnessSettingDefault">102</integer>

    <!-- Wi-Fi 5 GHz band support (MT6631 Dual-Band) -->
    <bool translatable="false" name="config_wifi_dual_band_support">true</bool>

    <!-- Flag indicating whether the device supports soft AP -->
    <bool translatable="false" name="config_wifi_softap_24ghz_supported">true</bool>
    <bool translatable="false" name="config_wifi_softap_5ghz_supported">true</bool>

    <!-- Default network capabilities (Wi-Fi only / Tablet) -->
    <string-array translatable="false" name="networkAttributes">
        <item>"wifi,1,1,1,-1,true"</item>
        <item>"bluetooth,7,7,2,-1,true"</item>
        <item>"ethernet,9,9,9,-1,true"</item>
    </string-array>

    <!-- Configure mobile network as disabled by default for tablet -->
    <bool name="config_voice_capable">false</bool>
    <bool name="config_sms_capable">false</bool>

    <!-- User activity timeouts -->
    <integer name="config_screenOffDelay">7000</integer>

</resources>
